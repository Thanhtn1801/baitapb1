{
  "manifest_version": 3,
  "name": "Flow Studio • Excel to Video",
  "version": "0.3.0",
  "description": "Bảng điều khiển trong Flow: Excel → ảnh → video → Google Drive → Excel.",
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Ẩn / hiện Flow Studio"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "app.js",
        "style.css"
      ],
      "matches": [
        "https://flow.google.com/*"
      ]
    }
  ]
}
